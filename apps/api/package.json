{
  "name": "@arenahub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "dev:worker": "node --env-file=../../.env --import tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration.mjs",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code && prisma migrate diff --config prisma.identity.config.ts --from-config-datasource --to-schema prisma/identity.prisma --exit-code && node scripts/check-schema.mjs",
    "db:generate": "prisma generate",
    "org:create": "node --env-file-if-exists=../../.env --import tsx scripts/org-create.ts",
    "theme:check": "node --import tsx scripts/theme.ts check",
    "theme:publish": "node --import tsx scripts/theme.ts publish",
    "openapi:generate": "node scripts/openapi-phase3.mjs",
    "openapi:check": "node scripts/openapi-phase3.mjs --check",
    "db:seed": "node --env-file=../../.env --import tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "@arenahub/contracts": "workspace:*",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "pg": "8.23.1",
    "pg-boss": "12.40.0",
    "pino": "10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "playwright-core": "^1.65.1",
    "prisma": "^7.10.1",
    "testcontainers": "12.2.2",
    "tsx": "^4.23.15"
  }
}
