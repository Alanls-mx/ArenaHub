{
  "name": "@arenahub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "dev:worker": "node --env-file=../../.env --import tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration.mjs",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code && node scripts/check-schema.mjs",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@arenahub/contracts": "workspace:*",
    "@fastify/helmet": "^13.2.0",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "pg": "8.23.1",
    "pg-boss": "12.40.0",
    "pino": "10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  }
}
