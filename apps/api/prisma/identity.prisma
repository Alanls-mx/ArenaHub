}

/// SQL migration enforces weekdays and positive durations.
model recurrence_rules {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String      @db.Uuid
  recurrence_id    String      @db.Uuid
  weekday          Int         @db.SmallInt
  start_time       DateTime    @db.Time(6)
  duration_minutes Int
  recurrences      recurrences @relation(fields: [organization_id, recurrence_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, id])
  @@unique([organization_id, recurrence_id, weekday])
  @@schema("arena_identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model recurrences {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                  @db.Uuid
  contract_id            String                  @db.Uuid
  venue_id               String                  @db.Uuid
  sport_id               String?                 @db.Uuid
  weekday                Int                     @db.SmallInt
  start_time             DateTime                @db.Time(6)
  duration_minutes       Int
  starts_on              DateTime                @db.Date
  ends_on                DateTime?               @db.Date
  effective_from         DateTime                @db.Date
  price_cents            BigInt
  monthly_amount_cents   BigInt?
  previous_recurrence_id String?                 @db.Uuid
  generated_until        DateTime?               @db.Date
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  recurrence_exceptions  recurrence_exceptions[]
  recurrence_rules       recurrence_rules[]
  recurrence_contracts   recurrence_contracts    @relation(fields: [organization_id, contract_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)
  recurrences            recurrences?            @relation("recurrencesTorecurrences", fields: [organization_id, previous_recurrence_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)
  other_recurrences      recurrences[]           @relation("recurrencesTorecurrences")
  sports                 sports?                 @relation(fields: [organization_id, sport_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)
  venues                 venues                  @relation(fields: [organization_id, venue_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)
  reservations           reservations[]

  @@unique([organization_id, id])
  @@index([organization_id, generated_until, starts_on], map: "recurrences_generation")
  @@schema("arena_identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservation_commercial_outcomes {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String       @db.Uuid
  reservation_id       String       @db.Uuid
  kind                 String
  policy_version       Int
  amount_cents         BigInt
  original_price_cents BigInt?
  policy_percent       Int?
  lead_seconds         BigInt?
  applied_exception    Boolean      @default(false)
  previous_price_cents BigInt?
  reason               String?
  waived_by            String?      @db.Uuid
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  reservations         reservations @relation(fields: [organization_id, reservation_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction, map: "reservation_commercial_outcom_organization_id_reservation__fkey")
  memberships          memberships? @relation(fields: [organization_id, waived_by], references: [organization_id, user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, id])
  @@unique([organization_id, reservation_id, kind], map: "reservation_terminal_outcome", where: raw("(kind = ANY (ARRAY['CANCELLATION'::text, 'NO_SHOW'::text]))"))
  @@schema("arena_identity")
}

/// Validated payment references only; financial ledger belongs to Phase 5.
model reservation_payment_confirmations {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String       @db.Uuid
  reservation_id        String       @db.Uuid
  customer_id           String       @db.Uuid
  external_payment_ref  String
  approved_amount_cents BigInt
  approved_at           DateTime     @db.Timestamptz(6)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  reservations          reservations @relation(fields: [organization_id, customer_id, reservation_id], references: [organization_id, customer_id, id], onDelete: NoAction, onUpdate: NoAction, map: "reservation_payment_confirmat_organization_id_customer_id__fkey")

  @@unique([organization_id, id])
  @@unique([organization_id, external_payment_ref], map: "reservation_payment_confirmat_organization_id_external_paym_key")
  @@unique([organization_id, reservation_id, external_payment_ref], map: "reservation_payment_confirmat_organization_id_reservation_i_key")
  @@index([organization_id, reservation_id], map: "reservation_payment_confirmations_reservation")
  @@schema("arena_identity")
}

model reservation_history {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  reservation_id  String       @db.Uuid
  action          String
