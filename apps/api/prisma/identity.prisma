}

model venue_sports {
  organization_id String @db.Uuid
  venue_id        String @db.Uuid
  sport_id        String @db.Uuid
  sports          sports @relation(fields: [organization_id, sport_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)
  venues          venues @relation(fields: [organization_id, venue_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([organization_id, venue_id, sport_id])
  @@index([organization_id, sport_id], map: "venue_sports_sport")
  @@schema("arena_identity")
}

model venue_unit_links {
  organization_id String      @db.Uuid
