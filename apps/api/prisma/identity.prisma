generator client {
  provider        = "prisma-client"
  output          = "../src/generated/identity"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["arena_identity"]
}

model audit_logs {
  id              BigInt         @id @default(autoincrement())
  actor_id        String         @db.Uuid
  organization_id String?        @db.Uuid
  action          String
  entity          String
  request_id      String
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  users           users          @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("arena_identity")
}

model invites {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  email           String
  token_hash      String        @unique
  invited_by      String        @db.Uuid
  expires_at      DateTime      @db.Timestamptz(6)
  closed_at       DateTime?     @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships     memberships   @relation(fields: [organization_id, invited_by], references: [organization_id, user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, email], map: "pending_email", where: raw("(closed_at IS NULL)"))
  @@schema("arena_identity")
}

model membership_roles {
  organization_id String      @db.Uuid
  user_id         String      @db.Uuid
  role_id         String      @db.Uuid
  roles           roles       @relation(fields: [organization_id, role_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction)
  memberships     memberships @relation(fields: [organization_id, user_id], references: [organization_id, user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([organization_id, user_id, role_id])
  @@schema("arena_identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model memberships {
  organization_id                                                     String                            @db.Uuid
  user_id                                                             String                            @db.Uuid
  status                                                              String                            @default("active")
  is_owner                                                            Boolean                           @default(false)
  idempotency_keys                                                    idempotency_keys[]
  invites                                                             invites[]
  membership_roles                                                    membership_roles[]
  organizations                                                       organizations                     @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                               users                             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization_themes                                                 organization_themes[]
  recurrence_contracts                                                recurrence_contracts[]
  recurrence_exceptions                                               recurrence_exceptions[]
  reservation_commercial_outcomes                                     reservation_commercial_outcomes[]
  reservation_history                                                 reservation_history[]
  reservations_reservations_organization_id_cancelled_byTomemberships reservations[]                    @relation("reservations_organization_id_cancelled_byTomemberships")
  reservations_reservations_organization_id_created_byTomemberships   reservations[]                    @relation("reservations_organization_id_created_byTomemberships")
  venue_blocks_venue_blocks_organization_id_cancelled_byTomemberships venue_blocks[]                    @relation("venue_blocks_organization_id_cancelled_byTomemberships")
  venue_blocks_venue_blocks_organization_id_created_byTomemberships   venue_blocks[]                    @relation("venue_blocks_organization_id_created_byTomemberships")

  @@id([organization_id, user_id])
  @@schema("arena_identity")
}

model organization_themes {
  organization_id String        @id @db.Uuid
  theme           Json
  previous_theme  Json?
  version         Int           @default(1)
  published_at    DateTime      @default(now()) @db.Timestamptz(6)
  published_by    String        @db.Uuid
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships     memberships   @relation(fields: [organization_id, published_by], references: [organization_id, user_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("arena_identity")
}

model organizations {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String                 @unique
  name                 String
  active               Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  timezone             String                 @default("America/Sao_Paulo")
  audit_logs           audit_logs[]
  calendar_exceptions  calendar_exceptions[]
  customers            customers[]
  idempotency_keys     idempotency_keys[]
  invites              invites[]
  memberships          memberships[]
  organization_domains organization_domains[]
  organization_themes  organization_themes?
  recurrence_contracts recurrence_contracts[]
  reservations         reservations[]
  roles                roles[]
  sports               sports[]
  venue_blocks         venue_blocks[]
  venue_units          venue_units[]
  venues               venues[]

  @@schema("arena_identity")
}

model organization_domains {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  hostname        String        @unique
  kind            String
  status          String        @default("pending")
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  activated_at    DateTime?     @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organization_id], map: "organization_domains_org")
  @@schema("arena_identity")
}

model password_resets {
  token_hash String   @id
  user_id    String   @db.Uuid
  expires_at DateTime @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("arena_identity")
}

model permissions {
  code             String             @id
  role_permissions role_permissions[]

  @@schema("arena_identity")
}

model role_permissions {
  organization_id String      @db.Uuid
  role_id         String      @db.Uuid
  code            String
  permissions     permissions @relation(fields: [code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  roles           roles       @relation(fields: [organization_id, role_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([organization_id, role_id, code])
  @@schema("arena_identity")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model roles {
  organization_id  String             @db.Uuid
  id               String             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  description      String             @default("")
  membership_roles membership_roles[]
  role_permissions role_permissions[]
  organizations    organizations      @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([organization_id, id])
  @@schema("arena_identity")
}

model sessions {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  seen_at    DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("arena_identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String            @unique
  name            String
  password_hash   String
  disabled_at     DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  audit_logs      audit_logs[]
  memberships     memberships[]
  password_resets password_resets[]
  sessions        sessions[]

  @@schema("arena_identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model calendar_exceptions {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  venue_id        String?       @db.Uuid
  date            DateTime      @db.Date
  kind            String
  open_time       DateTime?     @db.Time(6)
  close_time      DateTime?     @db.Time(6)
  description     String        @default("")
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venues          venues?       @relation(fields: [organization_id, venue_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, id])
  @@unique([organization_id, venue_id, date])
  @@schema("arena_identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model customers {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String                 @db.Uuid
  name                 String
  phone_e164           String?
  email                String?
  archived_at          DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recurrence_contracts recurrence_contracts[]
  reservations         reservations[]

  @@unique([organization_id, id])
  @@index([organization_id, phone_e164], map: "customers_phone")
  @@schema("arena_identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model operating_hours {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  venue_id        String   @db.Uuid
  weekday         Int      @db.SmallInt
  open_time       DateTime @db.Time(6)
  close_time      DateTime @db.Time(6)
  spans_full_day  Boolean  @default(false)
  venues          venues   @relation(fields: [organization_id, venue_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, id])
  @@index([organization_id, venue_id, weekday], map: "operating_hours_venue_day")
  @@schema("arena_identity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pricing_rules {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String         @db.Uuid
  venue_id             String         @db.Uuid
  sport_id             String?        @db.Uuid
  specific_date        DateTime?      @db.Date
  weekday              Int?           @db.SmallInt
  start_minute         Int            @db.SmallInt
  end_minute           Int            @db.SmallInt
  price_per_hour_cents BigInt
  valid_from           DateTime?      @db.Date
  valid_until          DateTime?      @db.Date
  archived_at          DateTime?      @db.Timestamptz(6)
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  updated_at           DateTime       @default(now()) @db.Timestamptz(6)
  sports               sports?        @relation(fields: [organization_id, sport_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)
  venues               venues         @relation(fields: [organization_id, venue_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)
  reservations         reservations[]

  @@unique([organization_id, id])
