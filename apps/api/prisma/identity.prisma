  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  customers       customers     @relation(fields: [organization_id, customer_id], references: [organization_id, id], onDelete: NoAction, onUpdate: NoAction)
  memberships     memberships?  @relation(fields: [organization_id, ended_by], references: [organization_id, user_id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recurrences     recurrences[]

  @@unique([organization_id, customer_id, id])
  @@unique([organization_id, id])
  @@index([organization_id, customer_id, status], map: "recurrence_contracts_customer")
  @@schema("arena_identity")
}

