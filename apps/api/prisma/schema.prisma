generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Spike da Fase 1: tabelas mínimas, sem FKs de reserva/bloqueio.
model ScheduleUnit {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String
  occupancies    ScheduleOccupancy[]

  @@unique([organizationId, id])
  @@map("schedule_units")
}

model ScheduleOccupancy {
  id             String  @id @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  unitId         String  @map("unit_id") @db.Uuid
  startAt        DateTime @map("start_at") @db.Timestamptz(3)
  endAt          DateTime @map("end_at") @db.Timestamptz(3)
  period         Unsupported("tstzrange")? @default(dbgenerated())
  active         Boolean @default(true)
  unit           ScheduleUnit @relation(fields: [organizationId, unitId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, startAt])
  @@map("schedule_occupancies")
}

// Infraestrutura experimental da Fase 1. FKs de identidade entram na Fase 2.
model IdempotencyRecord {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.Uuid
  method         String
  route          String
  pathParams     Json     @map("path_params")
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([organizationId, userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

